@model CourierManagementSystem.Models.Customer


<div class="glass-card p-4 mt-4 animate__animated animate__fadeIn">
    <h2 class="text-primary fw-bold">Customer: @Model.Name</h2>
    <hr />


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0"><i class="fas fa-history me-2"></i>Booking History</h4>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>


    <table class="table table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Tracking ID</th>
                <th>Receiver</th>
                <th>Weight</th>
                <th>Cost</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BookedParcels != null && Model.BookedParcels.Any())
            {
                @foreach (var p in Model.BookedParcels)
                {
                    <tr>
                        <td><code>@p.TrackingNumber</code></td>
                        <td>@p.ReceiverName</td>
                        <td>@p.Weight Kg</td>
                        <td class="text-success fw-bold">Rs. @p.TotalCost</td>
                        <td><span class="badge bg-info">@p.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No booking history found for this customer.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
