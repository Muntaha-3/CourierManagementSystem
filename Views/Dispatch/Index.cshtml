@model IEnumerable<CourierManagementSystem.Models.Parcel>
@{
    Layout = "_Layout";
}


<div class="container py-4 animate__animated animate__fadeIn">
    <!-- NAVIGATION BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/Dashboard/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
            <h2 class="fw-bold text-dark"><i class="fas fa-truck-loading me-2 text-warning"></i>Dispatch Hub</h2>
        </div>
        <span class="badge bg-warning text-dark rounded-pill px-4 py-2 shadow-sm">
            @Model.Count() Parcels Pending Dispatch
        </span>
    </div>


    <div class="glass-card p-0 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <table class="table table-hover mb-0">
            <thead class="bg-dark text-white text-center">
                <tr>
                    <th class="py-3">Consignment #</th>
                    <th>Sender</th>
                    <th>Destination</th>
                    <th>Weight</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var p in Model)
                {
                    <tr class="align-middle">
                        <td><code class="fw-bold text-primary">@p.TrackingNumber</code></td>
                        <td class="fw-bold">@p.Sender?.Name</td>
                        <td><i class="fas fa-map-marker-alt text-danger me-1"></i> @p.ReceiverAddress</td>
                        <td>@p.Weight Kg</td>
                        <td>
                            <a asp-action="AssignDriver" asp-route-id="@p.Id" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">
                                <i class="fas fa-user-plus me-1"></i> Assign Driver
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="py-5 text-muted">
                            <i class="fas fa-check-circle fa-3x text-success mb-3 d-block"></i>
                            🎉 All parcels have been successfully dispatched!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
