@using CourierManagementSystem.Models
@model CourierManagementSystem.Models.Parcel
@{
    Layout = "_Layout";
}


<div class="container mt-4 animate__animated animate__fadeInUp">
    <div class="glass-card p-5 shadow-lg border-0 bg-white rounded-4">
        <h2 class="fw-bold text-primary mb-4 text-center">New Shipment Booking</h2>
        <form asp-action="Create" method="post">
            <div class="row g-4">
                <div class="col-md-6 border-end pe-4">
                    <h5 class="fw-bold text-dark mb-3">1. Origin & Service</h5>


                    <label class="small fw-bold">Select Sender</label>
                    <select asp-for="CustomerId" class="form-select border-primary rounded-pill p-3 mb-3" required>
                        <option value="">-- Choose Sender --</option>
                        @{
                            var customerList = ViewBag.Customers as List<CourierManagementSystem.Models.Customer>;
                            if (customerList != null)
                            {
                                foreach (var c in customerList)
                                {
                                    <option value="@c.Id">@c.Name (@c.PhoneNumber)</option>
                                }
                            }
                        }
                    </select>


                    <label class="small fw-bold">Service Type</label>
                    <select asp-for="Service" class="form-select border-primary rounded-pill p-3 mb-3">
                        <option value="0">Standard</option>
                        <option value="1">Express</option>
                    </select>


                    <label class="small fw-bold">Weight (Kg)</label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control border-primary rounded-pill p-3" required />
                </div>


                <div class="col-md-6 ps-4">
                    <h5 class="fw-bold text-success mb-3">2. Receiver Address (Global API)</h5>
                    <input asp-for="ReceiverName" class="form-control mb-2 rounded-pill p-3" placeholder="Receiver Name" required />


                    @* Added ReceiverPhone logic (Starts 03, Max 11) *@
                    <label class="small fw-bold text-success ps-2">Receiver Phone (03XXXXXXXXX)</label>
                    <input asp-for="ReceiverPhone" id="ReceiverPhone" class="form-control mb-2 rounded-pill p-3"
                           placeholder="03XXXXXXXXX" maxlength="11" required />
                    <span asp-validation-for="ReceiverPhone" class="text-danger small"></span>


                    <select asp-for="ReceiverCountry" id="CountrySel" class="form-select rounded-pill mb-2 border-success p-3" required>
                        <option value="">Loading Countries...</option>
                    </select>


                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <select asp-for="ReceiverProvince" id="ProvinceSel" class="form-select rounded-pill border-success p-3" disabled required></select>
                        </div>
                        <div class="col-6">
                            <select asp-for="ReceiverCity" id="CitySel" class="form-select rounded-pill border-success p-3" disabled required></select>
                        </div>
                    </div>
                    <input asp-for="ReceiverArea" class="form-control mb-2 rounded-pill p-3" placeholder="Area/Town" required />
                    <input asp-for="ReceiverAddress" class="form-control rounded-pill p-3" placeholder="House/Street No" required />
                </div>
            </div>
            <div class="mt-5 text-center">
                <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill fw-bold shadow">BOOK SHIPMENT</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/addressApi.js"></script>
    <script>
        $(document).ready(function () {
        // Receiver Phone logic: starts 03, max 11 digits
        $('#ReceiverPhone').on('input', function () {
        this.value = this.value.replace(/[^0-9]/g, '');
        if (this.value.length > 0 && this.value[0] !== '0') this.value = '';
        if (this.value.length > 1 && this.value[1] !== '3') this.value = '0';
        });
        });
    </script>
}
