@model IEnumerable<CourierManagementSystem.Models.Parcel>
@{
    Layout = "_Layout";
}


<div class="container animate__animated animate__fadeIn mt-4">


    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary rounded-pill px-4 py-2 shadow-sm fw-bold">
            <i class="fas fa-arrow-left me-2"></i> Back to Dashboard
        </a>
        <a asp-controller="Tracking" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-bold">
            Next to Control Room <i class="fas fa-arrow-right ms-2"></i>
        </a>
    </div>


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-boxes text-success me-2"></i>Shipment Registry</h2>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">+ Book New</a>
    </div>


    <div class="glass-card p-0 overflow-hidden shadow-sm border-0">
        <table class="table table-hover mb-0">
            <thead class="bg-dark text-white text-center">
                <tr>
                    <th class="py-3">Parcel ID</th>
                    <th>Customer ID</th>
                    <th>Sender Name</th>
                    <th>Receiver</th>
                    <th>Weight</th>
                    <th>Cost (PKR)</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var item in Model)
                {
                    <tr class="align-middle">
                        <td><span class="badge bg-primary rounded-pill px-3 py-2">#@item.Id</span></td>
                        <td><span class="badge bg-secondary rounded-pill px-3 py-2">C-@item.CustomerId</span></td>
                        <td class="fw-bold">@item.Sender?.Name</td>
                        <td>@item.ReceiverName <br /><small class="text-muted">@item.ReceiverPhone</small></td>
                        <td>@item.Weight Kg</td>
                        <td class="text-success fw-bold">Rs. @item.TotalCost</td>
                        <td><span class="badge bg-warning text-dark px-3 rounded-pill">@item.Status</span></td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-warning me-2"><i class="fas fa-pen"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <!-- KEY LEGEND -->
    <div class="mt-3 d-flex gap-3">
        <small class="text-muted"><span class="badge bg-primary rounded-pill">#</span> Parcel ID = unique record in Parcels table</small>
        <small class="text-muted"><span class="badge bg-secondary rounded-pill">C-</span> Customer ID = FK linking to Customers table</small>
    </div>
</div>
