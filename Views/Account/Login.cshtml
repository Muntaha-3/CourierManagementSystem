@{
    Layout = "_Layout";
}


<div class="login-bg d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="col-md-4">
        <div class="glass-card animate__animated animate__zoomIn text-center p-4 shadow-lg rounded">


            <div class="mb-4">
                <i class="fas fa-shipping-fast fa-3x text-primary"></i>
                <h2 class="fw-bold mt-2">CourierPro Login</h2>
            </div>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger animate__animated animate__shakeX shadow-sm border-0 rounded text-center py-2 mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
                </div>
            }


            <form action="/Account/Login" method="post">


                <div class="form-floating mb-3 text-start">
                    <input type="email" name="email" class="form-control" id="email" placeholder="name@example.com" required autocomplete="email">
                    <label for="email">Email address</label>
                </div>


                <div class="form-floating mb-4 text-start">
                    <input type="password" name="password" class="form-control" id="pw" placeholder="Password" required>
                    <label for="pw">Password</label>
                </div>


                <button type="submit" class="btn btn-primary btn-modern w-100 py-2 fw-bold">SIGN IN</button>
            </form>


        </div>
    </div>
</div>
